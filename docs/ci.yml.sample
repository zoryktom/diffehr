name: ci

on:
  push:
  pull_request:

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - name: Run unit tests
        run: PYTHONPATH=src python -m unittest discover -s tests
      - name: Validate example contracts
        run: PYTHONPATH=src python -m diffehr validate examples/oncology/contracts
      - name: Run smoke evaluation
        run: PYTHONPATH=src python -m diffehr evaluate examples/oncology/contracts --model oracle --out /tmp/oracle.json

